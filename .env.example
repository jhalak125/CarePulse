# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Prisma SQLite by default, swap with PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://user:password@localhost:5432/healthcare_db?schema=public"

# JWT Secret
JWT_SECRET=super_secret_healthcare_jwt_key_2026_pulse_secure
JWT_EXPIRES_IN=7d

# Google Gemini API Key for LLM Summaries (Fallback heuristic engine kicks in if empty/invalid)
GEMINI_API_KEY=

# Google Calendar OAuth 2.0 Credentials (Mock mode activates if empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth-callback

# Email Configuration (Nodemailer)
# If left empty, system automatically generates an Ethereal Test Account with live preview URLs!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CarePulse Healthcare <no-reply@carepulse.health>"
